/playwright.config.ts                      @your-org/frontend-team
/.storybook/                               @your-org/frontend-team

# ----- Tests (engine team owns engine tests, frontend owns e2e) -----
/src/lib/opencex/*.test.ts                 @your-org/engine-team
/src/lib/opencex/*.property.test.ts        @your-org/engine-team
/tests/                                    @your-org/frontend-team @your-org/qa-team

# ----- Static assets -----
/public/                                   @your-org/frontend-team
/public/ostrich.svg                        @your-org/core-maintainers

# ----- Environment (templates only — real .env is gitignored) -----
/.env.example                              @your-org/security-team @your-org/infra-team

# =============================================================================
# Team definitions — create these teams in your GitHub org settings:
#   @your-org/core-maintainers   — lead engineers, can approve any PR
#   @your-org/engine-team        — matching engine specialists
#   @your-org/frontend-team      — React/UI specialists
#   @your-org/security-team      — security reviewers (auth, secrets, infra)
#   @your-org/infra-team         — DevOps + Kubernetes + CI/CD
#   @your-org/db-team            — database + migrations
#   @your-org/docs-team          — documentation maintainers
#   @your-org/release-team       — release managers (changelog, versioning)
#   @your-org/qa-team            — QA engineers (e2e tests, visual regression)
#
# Until these teams exist, replace @your-org/<team> with individual GitHub
# usernames (e.g. @alice @bob).
# =============================================================================
