#!/usr/bin/env sh
# Husky pre-commit hook for Mbuni CEX
# Runs on every `git commit` — blocks the commit if any check fails.
#
# What it does:
#   1. lint-staged — runs ESLint --fix on staged TS/TSX files only (fast)
#   2. Unit tests — full Vitest run (~500ms) to catch regressions
#   3. Secret scan — blocks commits that look like they contain secrets
#
# Bypass (emergency only):  git commit --no-verify
# (CI will still catch issues — don't make this a habit)

echo "── Mbuni CEX pre-commit ───────────────────────────────────────"

# 1. Lint staged files
echo "› Linting staged files (lint-staged)…"
bunx lint-staged || {
  echo "✗ lint-staged failed. Fix the issues above or run 'git commit --no-verify' to bypass."
  exit 1
}

# 2. Unit tests (fast — ~500ms)
echo "› Running unit tests (vitest)…"
bun run test:unit > /dev/null 2>&1 || {
  echo "✗ Unit tests failed. Run 'bun run test:unit' to see failures."
  echo "  Bypass with 'git commit --no-verify' (CI will still check)."
  exit 1
}

# 3. Secret scan — block common secret patterns from being committed.
#    Skip obvious placeholders (fake-secret, replace-with, ci-build, etc.)
echo "› Scanning staged files for secrets…"
# Use a simple, portable regex (avoid \x27 which doesn't work in all greps).
# Match: NEXTAUTH_SECRET="<8+ chars>", password="<8+ chars>",
# api_key="<8+ chars>", sk_live_<20+>, ghp_<20+>, AKIA<16>
# Then filter out lines containing placeholder markers.
SECRETS_PATTERN='(NEXTAUTH_SECRET=.{8,}|password\s*=\s*.{8,}|api[_-]?key\s*=\s*.{8,}|sk_live_[a-zA-Z0-9]{20,}|ghp_[a-zA-Z0-9]{20,}|AKIA[A-Z0-9]{16})'
PLACEHOLDER_PATTERN='(fake|placeholder|replace|example|ci[-_]?build|test[-_]?secret|your[-_]?secret|xxxx|<.+>|fake-secret)'
if git diff --cached --diff-filter=ACMR | grep -E "$SECRETS_PATTERN" | grep -ivE "$PLACEHOLDER_PATTERN" 2>/dev/null; then
  echo "✗ Potential secret detected in staged changes."
  echo "  If this is a false positive, bypass with 'git commit --no-verify'."
  echo "  Otherwise, remove the secret and use a .env file (which is gitignored)."
  exit 1
fi

echo "✓ All pre-commit checks passed."
