# =============================================================================
# Mbuni CEX — Caddy reverse proxy config
#
# Caddy automatically provisions + renews Let's Encrypt TLS certificates for
# real domains. For local dev (DOMAIN=localhost), it serves plain HTTP on :80.
#
# The {$DOMAIN} placeholder reads from the `DOMAIN` env var set in
# docker-compose.yml.
# =============================================================================

{
	# Global options
	email admin@{$DOMAIN}
	# Uncomment for staging certificates (don't hit rate limits while testing):
	# acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
}

# ----- Production domain (auto-TLS via Let's Encrypt) -----
# When DOMAIN is a real domain (e.g. cex.example.com), Caddy auto-provisions
# TLS certs. When DOMAIN=localhost, Caddy falls back to plain HTTP.
{$DOMAIN} {
	encode gzip zstd

	# Security headers
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# CSP — adjust to match your needs; the app is same-origin by default
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none';"
		# Remove Server header for security through obscurity (mild)
		-Server
	}

	# Proxy to the Next.js app
	reverse_proxy {$APP_HOST} {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}

	# Compression for static assets
	@static path /_next/static/* /public/*
	header @static Cache-Control "public, max-age=31536000, immutable"
}

# ----- Local dev fallback (HTTP on :80, no TLS) -----
# When DOMAIN=localhost the block above already handles it (Caddy is smart
# about not attempting TLS for localhost). If you want explicit HTTP-only
# config, uncomment the block below and comment out the {$DOMAIN} block above.
#
# :80 {
# 	reverse_proxy {$APP_HOST}
# }
