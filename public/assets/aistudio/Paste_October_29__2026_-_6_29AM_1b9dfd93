            </span>
          </div>
        </div>
        <div className="flex items-center gap-1 shrink-0">
          {TIMEFRAMES.map((t) => (
            <button
              key={t.label}
              onClick={() => setTf(t.minutes)}
              className={`px-2 py-0.5 text-[11px] rounded ${
