              const k = aggregated[idx];
              if (!k) return null;
              return (
                <text key={t} x={xFor(idx)} y={H - 4} fill={LABEL} fontSize="9" className="tabular" textAnchor={t === 0 ? "start" : t === 1 ? "end" : "middle"}>
