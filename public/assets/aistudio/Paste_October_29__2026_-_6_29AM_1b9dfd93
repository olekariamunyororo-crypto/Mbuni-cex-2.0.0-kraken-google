"use client";

import { useEffect, useMemo, useRef, useState } from "react";
import { useOpenCEX } from "@/lib/opencex/store";
import { fmtPrice, fmtCompact } from "@/lib/opencex/format";
import type { Kline } from "@/lib/opencex/types";

const TIMEFRAMES = [
  { label: "1m", minutes: 1 },
  { label: "5m", minutes: 5 },
  { label: "15m", minutes: 15 },
  { label: "1h", minutes: 60 },
  { label: "4h", minutes: 240 },
];

const EMPTY_KLINES: Kline[] = [];

// Design-system colours (lime = up, red = down)
const UP = "#a3e635";
const DOWN = "#ff5c5c";
const GRID = "rgba(255,255,255,0.08)";
const LABEL = "#9ca3af";
const MAX_VISIBLE = 120; // candles drawn at once

/** Aggregate 1m candles into `minutes`-wide buckets aligned to wall-clock boundaries. */
export function aggregateKlines(klines: Kline[], minutes: number): Kline[] {
  if (!klines.length) return [];
  if (minutes <= 1) return klines;
  const ms = minutes * 60_000;
  const out: Kline[] = [];
  for (const k of klines) {
    const bucket = Math.floor(k.openTime / ms) * ms;
    const cur = out[out.length - 1];
    if (cur && cur.openTime === bucket) {
      cur.high = Math.max(cur.high, k.high);
      cur.low = Math.min(cur.low, k.low);
      cur.close = k.close;
      cur.volume += k.volume;
    } else {
      out.push({ openTime: bucket, open: k.open, high: k.high, low: k.low, close: k.close, volume: k.volume });
    }
  }
  return out;
}

function fmtAxis(ts: number, minutes: number): string {
  const d = new Date(ts);
  const t = d.toLocaleTimeString("en-US", { hour12: false, hour: "2-digit", minute: "2-digit" });
  return minutes >= 60 ? `${d.getMonth() + 1}/${d.getDate()} ${t}` : t;
}

/** Track the real pixel size of an element so the SVG is never stretched (text/candles stay undistorted). */
function useElementSize<T extends HTMLElement>() {
  const ref = useRef<T | null>(null);
  const [size, setSize] = useState({ w: 800, h: 360 });
  useEffect(() => {
    const el = ref.current;
    if (!el) return;
    const ro = new ResizeObserver(([entry]) => {
      const { width, height } = entry.contentRect;
      if (width > 0 && height > 0) setSize({ w: Math.round(width), h: Math.round(height) });
    });
    ro.observe(el);
    return () => ro.disconnect();
  }, []);
  return [ref, size] as const;
}


export function PriceChart({ pair }: { pair: string }) {
  const klines = useOpenCEX((s) => s.klines[pair]) ?? EMPTY_KLINES;
  const book = useOpenCEX((s) => s.books[pair]);
  const p = useOpenCEX((s) => s.pairs.find((x) => x.symbol === pair));
  const liveMode = useOpenCEX((s) => s.liveMode);
  const feedConnected = useOpenCEX((s) => s.feedConnected);
  const [tf, setTf] = useState(1);
  const [hover, setHover] = useState<Kline | null>(null);
  const [wrapRef, { w: W, h: H }] = useElementSize<HTMLDivElement>();

  const aggregated = useMemo(() => aggregateKlines(klines, tf).slice(-MAX_VISIBLE), [klines, tf]);

  if (!p) return null;

  const display = hover ?? aggregated[aggregated.length - 1] ?? null;
  const lastPrice = book?.lastPrice ?? display?.close ?? 0;
  const firstPrice = aggregated[0]?.open ?? lastPrice;
  const changePct = firstPrice ? ((lastPrice - firstPrice) / firstPrice) * 100 : 0;
  const up = changePct >= 0;

  // Chart geometry (real pixels)
  const volH = Math.min(60, H * 0.16);
  const padL = 8;
  const padR = 72;
  const padT = 10;
  const padB = 18;
  const priceH = H - volH - padB - 6;
  const chartW = Math.max(1, W - padL - padR);
  const chartH = Math.max(1, priceH - padT);
  const n = aggregated.length;

  // Include the last price in the scale so the price line can never fall outside the plot.
  const lows = aggregated.map((k) => k.low);
  const highs = aggregated.map((k) => k.high);
  const minPrice = n ? Math.min(...lows, lastPrice || Infinity) : 0;
