  const slot = n ? chartW / n : chartW;
  const candleW = Math.max(1.5, slot * 0.7);
  const xFor = (i: number) => padL + slot * (i + 0.5);
  const yFor = (price: number) => padT + (1 - (price - lo) / (hi - lo)) * chartH;

